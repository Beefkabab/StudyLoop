# StudyLoop Web Application Environment Configuration

# Database: MySQL connection string (e.g., TiDB Cloud Serverless or AWS RDS)
DATABASE_URL=mysql://user:password@gateway06.us-east-1.prod.aws.tidbcloud.com:4000/studyloop?ssl={"rejectUnauthorized":true}

# Authentication: Secure JWT signing secret
JWT_SECRET=your_super_secret_jwt_key_here

# Runtime Port (Render assigns this automatically via $PORT)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=production

# App Branding
VITE_APP_TITLE="StudyLoop — Find research that fits your life"
